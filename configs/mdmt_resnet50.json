{
  "model": {
    "backbone": "resnet50",
    "num_views": 2,
    "num_classes": 1,
    "num_queries": 25
  },
  "data": {
    "train": "data/processed/MDMT_car_q25/train.jsonl",
    "val": "data/processed/MDMT_car_q25/val.jsonl",
    "test": "data/processed/MDMT_car_q25/test.jsonl",
    "height": 405,
    "width": 720,
    "augment": true,
    "class_mode": "car_only",
    "class_mapping": {
      "car": 0
    },
    "max_instances": 25,
    "query_limit_policy": "filter_groups"
  },
  "training": {
    "epochs": 100,
    "batch_size": 4,
    "lr": 0.0001,
    "weight_decay": 1e-05,
    "optimizer": "adamw",
    "workers": 4,
    "seed": 42,
    "freeze_bn_stats": true,
    "clip_grad": 1.0
  },
  "evaluation": {
    "confidence_threshold": 0.5,
    "iou_threshold": 0.5,
    "ucr_threshold": 0.6
  }
}
