{
  "model": {
    "num_classes": 1,
    "num_views": 2,
    "backbone": "resnet50",
    "pretrained": true,
    "freeze_backbone": false,
    "hidden_dim": 256,
    "num_heads": 8,
    "ffn_ratio": 4,
    "dropout": 0.0,
    "mvff_layers": 3,
    "num_queries": 256,
    "giq_layers": 3,
    "mvoq_layers": 2,
    "cost_class": 1.0,
    "cost_bbox": 1.0,
    "weight_l1": 5.0,
    "weight_giou": 2.0,
    "weight_cls": 1.0,
    "weight_reg": 1.0,
    "weight_conf": 1.0,
    "mvoq_position_encoding": "normalized_keys_values",
    "mvoq_instance_residual": true,
    "mvoq_center_mode": "attention_reference"
  },
  "data": {
    "train": "data/processed/MDMT/full_dense_smoke/train.jsonl",
    "val": "data/processed/MDMT/full_dense_smoke/val.jsonl",
    "test": "data/processed/MDMT/test_official.jsonl",
    "height": 416,
    "width": 720,
    "augment": false
  },
  "training": {
    "epochs": 1,
    "batch_size": 4,
    "lr": 0.0001,
    "weight_decay": 1e-05,
    "optimizer": "adamw",
    "workers": 0,
    "seed": 42,
    "freeze_bn_stats": true,
    "background_weight": 0.1,
    "clip_grad": null,
    "limit_train": null,
    "limit_val": null,
    "freeze_backbone_stem": false,
    "center_loss_weight": 0.25
  },
  "evaluation": {
    "confidence_threshold": 0.5,
    "iou_threshold": 0.5,
    "ucr_threshold": 0.6
  }
}
